---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, type Language } from '../data/site';
import '../styles/hospitality-services.css';
import teaching from '../assets/images/brooke-teaching.webp';
import portrait from '../assets/images/brooke-portrait.jpeg';

interface Props { lang: Language }
const { lang } = Astro.props;
const r = routes[lang];
const isEnglish = lang === 'en';

const copy = isEnglish ? {
  metaTitle: 'Hospitality Services | 2Hands',
  metaDescription: 'Assessment, spa team training, signature treatment development and ongoing performance support for hotels, resorts, riads and spas.',
  heroEyebrow: 'Hotels & Spas',
  heroTitle: 'One connected approach to stronger spa performance.',
  heroLead: 'From understanding current treatment quality to strengthening teams and developing signature experiences, 2Hands shapes each engagement around the property’s real priorities.',
  heroPrimary: 'Discuss your priorities',
  heroSecondary: 'Meet Brooke',
  heroAlt: '2Hands professional massage and spa work',
  imageNote: 'Start with the need, not a fixed package. Services can stand alone or connect as a longer development pathway.',
  proof: [['Four pathways', 'One connected system'], ['Observe', 'See current reality'], ['Strengthen', 'Develop with focus'], ['Maintain', 'Protect progress']],
  servicesEyebrow: 'Choose the right starting point',
  servicesTitle: 'Support for each stage of spa development.',
  serviceCards: [
    ['01 · Assess', 'Recommended starting point', 'Spa Team Performance Assessment', 'See treatment quality clearly, identify the patterns affecting consistency, and define the right development priorities.', 'Explore assess', r.assessment],
    ['02 · Strengthen', 'Hospitality service', 'Hotel Spa Team Training', 'Focused, practical development built around your team, treatment menu and operational reality.', 'Explore strengthen', r.training],
    ['03 · Differentiate', 'Hospitality service', 'Signature Treatment Development', 'Create a distinctive, teachable treatment experience that feels true to your property and brand.', 'Explore differentiate', r.signature],
    ['04 · Maintain', 'Hospitality service', 'Ongoing Support', 'Protect progress through reassessment, recalibration and practical follow-up with the team.', 'Explore maintain', r.support],
  ],
  matrixEyebrow: 'Not sure where to begin?',
  matrixTitle: 'The assessment is often the clearest first step.',
  matrixIntro: 'When the priority is unclear, observation creates a reliable baseline. When management already knows the need, training, treatment development or ongoing support can begin directly from a focused brief.',
  matrixHeadOne: 'If you need to...',
  matrixHeadTwo: 'Start with...',
  matrixRows: [
    ['Understand current treatment quality', 'Assessment', r.assessment],
    ['Develop a known skill or standard', 'Team training', r.training],
    ['Create a differentiated guest experience', 'Signature treatment', r.signature],
    ['Reinforce progress over time', 'Ongoing support', r.support],
  ],
  processEyebrow: 'The 2Hands approach',
  processTitle: 'Observe. Understand. Strengthen. Maintain.',
  process: [
    ['01', 'Observe', 'Look closely at the treatment and the guest journey in context.'],
    ['02', 'Understand', 'Identify the patterns behind strengths, gaps and inconsistency.'],
    ['03', 'Strengthen', 'Develop the skills and standards with the greatest practical value.'],
    ['04', 'Maintain', 'Revisit, recalibrate and protect quality as the team evolves.'],
  ],
  founderEyebrow: 'The expert behind 2Hands',
  founderTitle: 'Technical depth with a human approach.',
  founderCopy: 'Brooke evaluates the treatment itself while understanding the realities of the therapist, the guest and management. Her work is developmental, practical and grounded in more than 25 years of international practice.',
  founderLink: 'Discover Brooke',
  ctaEyebrow: 'Tailored hospitality support',
  ctaTitle: 'Tell us what is happening in your spa.',
  ctaCopy: 'You do not need to choose the service before getting in touch. Share the situation and Brooke will recommend the most useful starting point.',
  ctaButton: 'Discuss your property',
} : {
  metaTitle: 'Services hôteliers | 2Hands',
  metaDescription: 'Diagnostic, formation des équipes spa, création de soins signature et accompagnement continu pour les hôtels, resorts, riads et spas.',
  heroEyebrow: 'Hôtellerie & Spas',
  heroTitle: 'Une approche connectée pour renforcer la performance spa.',
  heroLead: 'Comprendre la qualité actuelle, développer les équipes, créer des expériences signature et maintenir les progrès. Chaque intervention 2Hands part des priorités réelles de l’établissement.',
  heroPrimary: 'Discuter de vos priorités',
  heroSecondary: 'Découvrir Brooke',
  heroAlt: 'Travail professionnel 2Hands en massage et spa',
  imageNote: 'Commencer par le besoin, pas par une formule fixe. Les services peuvent être indépendants ou former un parcours de développement.',
  proof: [['Quatre parcours', 'Un système connecté'], ['Observer', 'Voir la réalité'], ['Renforcer', 'Développer avec précision'], ['Maintenir', 'Protéger les progrès']],
  servicesEyebrow: 'Choisir le bon point de départ',
  servicesTitle: 'Un accompagnement pour chaque étape du développement spa.',
  serviceCards: [
    ['01 · Évaluer', 'Point de départ recommandé', 'Diagnostic de performance de l’équipe spa', 'Observer la qualité réelle des soins, identifier les écarts de régularité et définir les priorités de développement.', 'Découvrir', r.assessment],
    ['02 · Renforcer', 'Service hôtelier', 'Formation des équipes spa hôtelières', 'Un développement pratique et ciblé, construit autour de l’équipe, de la carte de soins et de la réalité opérationnelle.', 'Découvrir', r.training],
    ['03 · Différencier', 'Service hôtelier', 'Création de soins signature', 'Créer une expérience distinctive, transmissible et cohérente avec l’identité de l’établissement.', 'Découvrir', r.signature],
    ['04 · Maintenir', 'Service hôtelier', 'Accompagnement continu', 'Protéger les progrès grâce à la réévaluation, au recalibrage et à un suivi concret de l’équipe.', 'Découvrir', r.support],
  ],
  matrixEyebrow: 'Vous hésitez ?',
  matrixTitle: 'Le diagnostic est souvent le point de départ le plus clair.',
  matrixIntro: 'Lorsque la priorité n’est pas encore définie, l’observation crée une base fiable. Lorsque le besoin est connu, la formation, la création de soin ou le suivi peuvent commencer directement.',
  matrixHeadOne: 'Si vous souhaitez...',
  matrixHeadTwo: 'Commencez par...',
  matrixRows: [
    ['Comprendre la qualité actuelle', 'Diagnostic', r.assessment],
    ['Développer une compétence connue', 'Formation', r.training],
    ['Créer une expérience distinctive', 'Soin signature', r.signature],
    ['Renforcer les progrès dans le temps', 'Suivi continu', r.support],
  ],
  processEyebrow: 'L’approche 2Hands',
  processTitle: 'Observer. Comprendre. Renforcer. Maintenir.',
  process: [
    ['01', 'Observer', 'Regarder le soin et le parcours client dans leur contexte.'],
    ['02', 'Comprendre', 'Identifier les tendances derrière les forces et les écarts.'],
    ['03', 'Renforcer', 'Développer les compétences qui créent le plus de valeur.'],
    ['04', 'Maintenir', 'Réévaluer et protéger la qualité au fil du temps.'],
  ],
  founderEyebrow: 'L’experte derrière 2Hands',
  founderTitle: 'Une expertise technique portée par une approche humaine.',
  founderCopy: 'Brooke évalue le soin lui-même tout en comprenant les réalités du thérapeute, du client et du management. Son travail est pratique, formateur et fondé sur plus de 25 ans d’expérience internationale.',
  founderLink: 'Découvrir Brooke',
  ctaEyebrow: 'Accompagnement sur mesure',
  ctaTitle: 'Parlez-nous de ce qui se passe dans votre spa.',
  ctaCopy: 'Vous n’avez pas besoin de choisir le service avant de nous contacter. Présentez la situation et Brooke recommandera le meilleur point de départ.',
  ctaButton: 'Parler de votre établissement',
};
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} {lang} enPath={routes.en.services} frPath={routes.fr.services}>
  <main id="main-content" class="hospitality-page">
    <section class="hospitality-hero">
      <div class="container hospitality-hero-grid">
        <div class="hospitality-hero-copy">
          <span class="eyebrow">{copy.heroEyebrow}</span>
          <h1>{copy.heroTitle}</h1>
          <p class="hospitality-lead">{copy.heroLead}</p>
          <div class="hospitality-hero-actions"><a class="button button-primary" href={r.contact}>{copy.heroPrimary}</a><a class="button button-outline" href={r.about}>{copy.heroSecondary}</a></div>
        </div>
        <figure class="hospitality-hero-visual"><Image src={teaching} alt={copy.heroAlt} widths={[500, 760, 1000]} sizes="(min-width: 900px) 48vw, 100vw" loading="eager" fetchpriority="high" /><figcaption>{copy.imageNote}</figcaption></figure>
      </div>
    </section>

    <section class="hospitality-proof-band" aria-label={isEnglish ? 'The connected 2Hands system' : 'Le système connecté 2Hands'}>
      <div class="container hospitality-proof-grid">{copy.proof.map(([title, detail]) => <div><strong>{title}</strong><span>{detail}</span></div>)}</div>
    </section>

    <section class="hospitality-section hospitality-soft">
      <div class="container"><span class="eyebrow">{copy.servicesEyebrow}</span><h2 class="hospitality-services-title">{copy.servicesTitle}</h2><div class="hospitality-service-grid">{copy.serviceCards.map(([number, type, title, detail, linkLabel, href], index) => <article class:list={['hospitality-service-card', { featured: index === 0 }]}><div class="hospitality-topline"><span>{number}</span><span>{type}</span></div><h3>{title}</h3><p>{detail}</p><a class="text-link" href={href}>{linkLabel}</a></article>)}</div></div>
    </section>

    <section class="hospitality-section">
      <div class="container hospitality-split">
        <div><span class="eyebrow">{copy.matrixEyebrow}</span><h2>{copy.matrixTitle}</h2><p class="hospitality-intro">{copy.matrixIntro}</p></div>
        <div class="hospitality-matrix-wrap"><table class="hospitality-matrix"><thead><tr><th>{copy.matrixHeadOne}</th><th>{copy.matrixHeadTwo}</th></tr></thead><tbody>{copy.matrixRows.map(([need, label, href]) => <tr><td>{need}</td><td><a class="text-link" href={href}>{label}</a></td></tr>)}</tbody></table></div>
      </div>
    </section>

    <section class="hospitality-section hospitality-dark">
      <div class="container"><span class="eyebrow eyebrow-light">{copy.processEyebrow}</span><h2>{copy.processTitle}</h2><div class="hospitality-process-grid">{copy.process.map(([number, title, detail]) => <article><span>{number}</span><h3>{title}</h3><p>{detail}</p></article>)}</div></div>
    </section>

    {isEnglish && <section class="hospitality-section"><div class="container hospitality-founder-strip"><Image src={portrait} alt="Brooke Wescott" widths={[320, 640]} sizes="(min-width: 900px) 320px, 100vw" loading="lazy" /><div><span class="eyebrow">{copy.founderEyebrow}</span><h2>{copy.founderTitle}</h2><p>{copy.founderCopy}</p></div><a class="text-link" href={r.about}>{copy.founderLink}</a></div></section>}

    <section class="hospitality-section"><div class="container hospitality-cta-panel"><div><span class="eyebrow eyebrow-light">{copy.ctaEyebrow}</span><h2>{copy.ctaTitle}</h2><p>{copy.ctaCopy}</p></div><a class="button button-cream" href={r.contact}>{copy.ctaButton}</a></div></section>
  </main>
</BaseLayout>
