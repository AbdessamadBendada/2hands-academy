---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, type Language } from '../data/site';
import '../styles/about.css';
import portrait from '../assets/images/brooke-portrait.jpeg';
import teachingLandscape from '../assets/images/brooke-teaching-landscape.webp';
import teaching from '../assets/images/brooke-teaching.webp';
import treatment from '../assets/images/current-site-photo-4.jpg';
import hands from '../assets/images/current-site-photo-2.jpg';
import fourSeasons from '../assets/images/client-logos/four-seasons-reference.png';
import nisae from '../assets/images/client-logos/nisae-official.png';
import endorfine from '../assets/images/client-logos/endorfine-official.png';
import myShala from '../assets/images/client-logos/myshala-official.png';
import wmf from '../assets/images/memberships/wmf-official-member.png';

interface Props { lang: Language }
const { lang } = Astro.props;
const r = routes[lang];
const isEnglish = lang === 'en';

const copy = isEnglish ? {
  metaTitle: 'Brooke Wescott | Founder of 2Hands', metaDescription: 'Discover Brooke Wescott, massage and spa performance consultant and founder of 2Hands, with more than 25 years of international practice.',
  heroEyebrow: 'Brooke Wescott · Founder of 2Hands', heroTitle: 'A career shaped by skilled touch, thoughtful assessment and the realities of practice.',
  heroLead: 'Brooke Wescott brings more than 25 years of hands-on experience in massage and bodywork, with a career spanning private practice, luxury hospitality and international clientele.',
  journeyButton: 'Discover her journey', workButton: 'Work with Brooke', heroAlt: 'Portrait of Brooke Wescott, founder of 2Hands',
  role: 'Massage & Spa Performance Consultant', location: 'Casablanca · Rabat · Projects across Morocco',
  facts: [['25+ years', 'International practice'], ['Technique-led', 'Assessment & development'], ['Two perspectives', 'Guest & practitioner']],
  experienceLabel: 'Experience with selected hospitality and wellness organizations', logosLabel: 'Organizations Brooke has worked with',
  journeyIndex: '01 · Her journey', journeyEyebrow: 'From practice to transmission', journeyTitle: 'From delivering treatments to helping practitioners and spa teams raise their standard.',
  journeyCopy: ['Brooke’s work has evolved from individual practice to therapist education and the development of stronger, more consistent spa teams.', 'Through 2Hands, she brings those experiences together: technical expertise, practical knowledge transfer and a close understanding of both what the guest experiences and what the practitioner’s body must sustain.', 'Her approach is grounded in observation rather than assumption. She looks at how a treatment is delivered, how it feels, how the practitioner moves and where precise changes can strengthen quality without erasing individuality.'],
  teachingAlt: 'Brooke Wescott demonstrating massage technique to a group', treatmentAlt: 'A professional massage treatment in progress',
  chapters: [['01 · Practice', 'Skilled touch', 'A foundation built through years of direct treatment experience, attentive listening and adapting to individual bodies.'], ['02 · Hospitality', 'Guest expectations', 'An understanding of how technique, presence, communication and consistency shape the complete spa experience.'], ['03 · Education', 'Practical transmission', 'Turning complex observations into clear, usable adjustments that therapists can understand, practise and retain.'], ['04 · 2Hands today', 'Team development', 'Supporting hotels and spas through assessment, targeted development, signature treatments and continuity.']],
  philosophyIndex: '02 · Her philosophy', philosophyEyebrow: 'Two perspectives · one standard', philosophyTitle: 'The guest and the practitioner should never be considered separately.',
  philosophyLead: 'Exceptional treatment quality should support the person receiving the treatment and the professional delivering it.',
  perspectives: [['01 · THE GUEST', 'A coherent, confident and memorable experience.', 'Every transition, gesture and interaction contributes to whether the guest feels safe, understood and genuinely cared for.'], ['02 · THE PRACTITIONER', 'Technique that can remain precise and sustainable.', 'Body mechanics, clarity, confidence and professional longevity are essential to protecting quality over time.']],
  expertiseIndex: '03 · Technique-focused development', expertiseEyebrow: 'What Brooke observes', expertiseTitle: 'Technique becomes more useful when it is connected to the whole treatment experience.',
  expertiseLead: 'Brooke’s assessments look beyond whether a protocol was followed. They examine the quality, intention and sustainability of how the treatment is actually delivered.', handsAlt: 'Hands preparing to deliver a professional massage treatment',
  expertise: [['01', 'Touch, pace and pressure', 'How the treatment feels, whether transitions are controlled and whether the practitioner adapts with precision.'], ['02', 'Presence and communication', 'How confidence, listening, explanation and non-verbal presence shape trust throughout the guest journey.'], ['03', 'Body mechanics and longevity', 'How practitioners use their own bodies, protect their energy and build habits that support a sustainable career.'], ['04', 'Consistency without uniformity', 'How a team can uphold a shared standard while preserving each practitioner’s awareness and individuality.']],
  credentialsIndex: '04 · Professional standing', credentialsEyebrow: 'Certifications, affiliations & recognition', credentialsTitle: 'Experience supported by professional standing.',
  credentialsLead: 'Brooke’s professional standing brings together international affiliation, continued professional development and recognition across massage, wellness and hospitality.',
  affiliationEyebrow: 'International affiliation', affiliationTitle: 'Official member of the World Massage Federation.', affiliationCopy: '2Hands is part of an international community dedicated to advancing massage practice, education and professional excellence.', verify: 'Verify membership', verified: 'Membership confirmed · verify on the official website', sealAlt: 'World Massage Federation official member seal',
  recognitionLabel: 'Certifications, industry participation and editorial recognition', recognition: [['Professional certifications', 'Formal training and continued professional development supporting Brooke’s practical expertise.'], ['World Massage Championships', 'International industry participation and exchange within the wider massage community.'], ['Editorial recognition', 'Selected editorial coverage of Brooke’s work and professional approach.']],
  beliefEyebrow: 'A standard with purpose', belief: '“Exceptional treatment standards should support both the person receiving the treatment and the professional delivering it.”', beliefBy: 'Brooke Wescott · Founder of 2Hands', beliefAlt: 'Brooke Wescott teaching massage technique',
  ctaEyebrow: 'Bring this perspective into your property', ctaTitle: 'Let’s discuss your team, your standards and the guest experience you want to create.', ctaCopy: 'A focused first conversation to understand your property, identify the priority and determine whether assessment, training or longer-term support is the right next step.', ctaPrimary: 'Discuss your property', ctaSecondary: 'Explore hospitality solutions',
} : {
  metaTitle: 'Brooke Wescott | Fondatrice de 2Hands', metaDescription: 'Découvrez Brooke Wescott, consultante en performance massage et spa et fondatrice de 2Hands, avec plus de 25 ans de pratique internationale.',
  heroEyebrow: 'Brooke Wescott · Fondatrice de 2Hands', heroTitle: 'Une carrière façonnée par la précision du toucher, l’observation et la réalité du métier.',
  heroLead: 'Brooke Wescott apporte plus de 25 ans d’expérience pratique en massage et travail corporel, dans la pratique privée, l’hôtellerie de luxe et auprès d’une clientèle internationale.',
  journeyButton: 'Découvrir son parcours', workButton: 'Travailler avec Brooke', heroAlt: 'Portrait de Brooke Wescott, fondatrice de 2Hands',
  role: 'Consultante en performance massage & spa', location: 'Casablanca · Rabat · Projets au Maroc',
  facts: [['25+ ans', 'Pratique internationale'], ['Expertise technique', 'Évaluation & développement'], ['Double perspective', 'Client & thérapeute']],
  experienceLabel: 'Expérience auprès d’établissements hôteliers et bien-être sélectionnés', logosLabel: 'Organisations avec lesquelles Brooke a travaillé',
  journeyIndex: '01 · Son parcours', journeyEyebrow: 'De la pratique à la transmission', journeyTitle: 'Du soin individuel à l’accompagnement des thérapeutes et des équipes spa.',
  journeyCopy: ['Le travail de Brooke a évolué de la pratique individuelle vers la formation des thérapeutes et le développement d’équipes spa plus solides et plus cohérentes.', 'Avec 2Hands, elle réunit ces expériences : expertise technique, transmission pratique et compréhension fine de ce que vit le client comme de ce que le corps du thérapeute doit soutenir.', 'Son approche repose sur l’observation plutôt que sur les suppositions. Elle analyse la façon dont le soin est réalisé, ce qu’il fait ressentir, la manière dont le thérapeute bouge et les ajustements précis qui peuvent renforcer la qualité sans effacer l’individualité.'],
  teachingAlt: 'Brooke Wescott démontre une technique de massage à un groupe', treatmentAlt: 'Un soin de massage professionnel en cours',
  chapters: [['01 · Pratique', 'Précision du toucher', 'Une base construite par des années de pratique directe, d’écoute attentive et d’adaptation à chaque personne.'], ['02 · Hôtellerie', 'Attentes du client', 'Une compréhension de la façon dont la technique, la présence, la communication et la cohérence façonnent l’expérience spa.'], ['03 · Formation', 'Transmission pratique', 'Transformer des observations complexes en ajustements clairs que les thérapeutes peuvent comprendre, pratiquer et intégrer.'], ['04 · 2Hands aujourd’hui', 'Développement des équipes', 'Accompagner hôtels et spas par l’évaluation, le développement ciblé, les soins signature et la continuité.']],
  philosophyIndex: '02 · Sa philosophie', philosophyEyebrow: 'Deux perspectives · un même standard', philosophyTitle: 'Le client et le thérapeute ne devraient jamais être considérés séparément.', philosophyLead: 'Un soin d’exception doit soutenir à la fois la personne qui le reçoit et le professionnel qui le réalise.',
  perspectives: [['01 · LE CLIENT', 'Une expérience cohérente, rassurante et mémorable.', 'Chaque transition, chaque geste et chaque interaction contribue au sentiment de sécurité, d’écoute et d’attention réelle.'], ['02 · LE THÉRAPEUTE', 'Une technique qui reste précise et durable.', 'La biomécanique, la clarté, la confiance et la longévité professionnelle sont essentielles pour préserver la qualité dans le temps.']],
  expertiseIndex: '03 · Développement technique', expertiseEyebrow: 'Ce que Brooke observe', expertiseTitle: 'La technique prend tout son sens lorsqu’elle s’inscrit dans l’expérience complète du soin.', expertiseLead: 'Les évaluations de Brooke ne se limitent pas au respect d’un protocole. Elles examinent la qualité, l’intention et la durabilité de la manière dont le soin est réellement réalisé.', handsAlt: 'Des mains préparent un soin de massage professionnel',
  expertise: [['01', 'Toucher, rythme et pression', 'Les sensations procurées, la maîtrise des transitions et la capacité du thérapeute à s’adapter avec précision.'], ['02', 'Présence et communication', 'La façon dont la confiance, l’écoute, les explications et la présence non verbale nourrissent la relation avec le client.'], ['03', 'Biomécanique et longévité', 'La manière dont les thérapeutes utilisent leur corps, protègent leur énergie et construisent des habitudes professionnelles durables.'], ['04', 'Cohérence sans uniformité', 'La façon dont une équipe peut maintenir un standard commun tout en préservant la conscience et l’individualité de chaque thérapeute.']],
  credentialsIndex: '04 · Références professionnelles', credentialsEyebrow: 'Certifications, affiliations & reconnaissance', credentialsTitle: 'Une expérience soutenue par des références professionnelles.', credentialsLead: 'Le parcours professionnel de Brooke réunit affiliation internationale, développement continu et reconnaissance dans les univers du massage, du bien-être et de l’hospitalité.',
  affiliationEyebrow: 'Affiliation internationale', affiliationTitle: 'Membre officiel de la World Massage Federation.', affiliationCopy: '2Hands fait partie d’une communauté internationale dédiée au développement de la pratique, de la formation et de l’excellence professionnelle dans le massage.', verify: 'Vérifier l’adhésion', verified: 'Adhésion confirmée · vérification sur le site officiel', sealAlt: 'Sceau de membre officiel de la World Massage Federation',
  recognitionLabel: 'Certifications, participation professionnelle et reconnaissance éditoriale', recognition: [['Certifications professionnelles', 'Formations et développement professionnel continu au service de l’expertise pratique de Brooke.'], ['Championnats du monde de massage', 'Participation et échanges au sein de la communauté internationale du massage.'], ['Reconnaissance éditoriale', 'Sélection de parutions consacrées au travail et à l’approche professionnelle de Brooke.']],
  beliefEyebrow: 'Un standard qui a du sens', belief: '« Un soin d’exception doit soutenir à la fois la personne qui le reçoit et le professionnel qui le réalise. »', beliefBy: 'Brooke Wescott · Fondatrice de 2Hands', beliefAlt: 'Brooke Wescott enseigne une technique de massage',
  ctaEyebrow: 'Intégrer cette perspective dans votre établissement', ctaTitle: 'Parlons de votre équipe, de vos standards et de l’expérience client que vous souhaitez créer.', ctaCopy: 'Un premier échange ciblé pour comprendre votre établissement, identifier la priorité et déterminer si l’évaluation, la formation ou un accompagnement dans la durée constitue la meilleure prochaine étape.', ctaPrimary: 'Parler de votre établissement', ctaSecondary: 'Découvrir les solutions hôtelières',
};
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} {lang} enPath={routes.en.about} frPath={routes.fr.about}>
  <main id="main-content" class="about-page">
    <section class="about-hero"><div class="container about-hero-grid"><div class="about-hero-copy"><span class="eyebrow">{copy.heroEyebrow}</span><h1>{copy.heroTitle}</h1><p class="about-lead">{copy.heroLead}</p><div class="about-actions"><a class="button button-primary" href="#journey">{copy.journeyButton}</a><a class="button button-outline" href={r.contact}>{copy.workButton}</a></div><div class="about-facts">{copy.facts.map(([title, detail]) => <div><strong>{title}</strong><span>{detail}</span></div>)}</div></div><figure class="about-hero-photo"><Image src={portrait} alt={copy.heroAlt} widths={[640, 900, 1200]} sizes="(min-width: 900px) 48vw, 100vw" loading="eager" fetchpriority="high" /><figcaption><strong>{copy.role}</strong><span>{copy.location}</span></figcaption></figure></div></section>

    <section class="about-experience"><div class="container about-experience-inner"><p>{copy.experienceLabel}</p><div class="about-logo-row" aria-label={copy.logosLabel}><div><Image src={fourSeasons} alt="Four Seasons Hotels and Resorts" /></div><div class="about-wordmark">Anfa Cliff<small>Wellness Center</small></div><div><Image src={nisae} alt="Nisaē" /></div><div><Image src={endorfine} alt="Endorfine" /></div><div><Image src={myShala} alt="My Shala" /></div><div class="about-wordmark">Matrescence<small>By Meryem</small></div></div></div></section>

    <section class="about-journey" id="journey"><div class="container"><div class="about-journey-intro"><div><span class="about-index">{copy.journeyIndex}</span><span class="eyebrow">{copy.journeyEyebrow}</span><h2>{copy.journeyTitle}</h2></div><div class="about-journey-copy">{copy.journeyCopy.map((text) => <p>{text}</p>)}</div></div><div class="about-journey-gallery"><figure><Image src={teachingLandscape} alt={copy.teachingAlt} widths={[640, 900]} sizes="(min-width: 760px) 50vw, 100vw" /></figure><figure><Image src={treatment} alt={copy.treatmentAlt} widths={[640, 900]} sizes="(min-width: 760px) 50vw, 100vw" /></figure></div><div class="about-career-grid">{copy.chapters.map(([label, title, detail]) => <article><span>{label}</span><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>

    <section class="about-perspective"><div class="container about-perspective-shell"><div class="about-perspective-heading"><div><span class="about-index">{copy.philosophyIndex}</span><span class="eyebrow eyebrow-light">{copy.philosophyEyebrow}</span><h2>{copy.philosophyTitle}</h2></div><p>{copy.philosophyLead}</p></div><div class="about-perspective-grid">{copy.perspectives.map(([label, title, detail]) => <article><span>{label}</span><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>

    <section class="about-expertise"><div class="container about-expertise-grid"><figure><Image src={hands} alt={copy.handsAlt} widths={[640, 900]} sizes="(min-width: 900px) 42vw, 100vw" /></figure><div class="about-expertise-content"><span class="about-index">{copy.expertiseIndex}</span><span class="eyebrow">{copy.expertiseEyebrow}</span><h2>{copy.expertiseTitle}</h2><p class="about-expertise-lead">{copy.expertiseLead}</p><div class="about-expertise-list">{copy.expertise.map(([number, title, detail]) => <div><span>{number}</span><div><h3>{title}</h3><p>{detail}</p></div></div>)}</div></div></div></section>

    <section class="about-credentials" id="credentials"><div class="container"><div class="about-credentials-heading"><div><span class="about-index">{copy.credentialsIndex}</span><span class="eyebrow">{copy.credentialsEyebrow}</span><h2>{copy.credentialsTitle}</h2></div><p>{copy.credentialsLead}</p></div><div class="about-membership"><Image src={wmf} alt={copy.sealAlt} /><div><span class="eyebrow">{copy.affiliationEyebrow}</span><h3>{copy.affiliationTitle}</h3><p>{copy.affiliationCopy}</p></div><div class="about-membership-action"><a class="button button-outline" href="https://worldmassagefederation.com/project/members/" target="_blank" rel="noopener">{copy.verify}</a><small>{copy.verified}</small></div></div><div class="about-recognition-grid" aria-label={copy.recognitionLabel}>{copy.recognition.map(([title, detail]) => <article><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>

    <section class="about-belief"><div class="container about-belief-card"><figure><Image src={teaching} alt={copy.beliefAlt} widths={[480, 720]} sizes="(min-width: 760px) 35vw, 100vw" /></figure><div><span class="eyebrow eyebrow-light">{copy.beliefEyebrow}</span><blockquote>{copy.belief}</blockquote><p>{copy.beliefBy}</p></div></div></section>

    <section class="about-final-cta"><div class="container"><span class="eyebrow eyebrow-light">{copy.ctaEyebrow}</span><h2>{copy.ctaTitle}</h2><p>{copy.ctaCopy}</p><div><a class="button button-cream" href={r.contact}>{copy.ctaPrimary}</a><a class="button about-outline-light" href={r.services}>{copy.ctaSecondary}</a></div></div></section>
  </main>
</BaseLayout>
