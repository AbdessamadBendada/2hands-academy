---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, type Language } from '../data/site';
import '../styles/spa-assessment.css';
import treatment from '../assets/images/current-site-photo-2.jpg';
import support from '../assets/images/current-site-photo-1.jpg';
import portrait from '../assets/images/brooke-portrait.jpeg';

interface Props { lang: Language; service: 'signature' | 'support' }
const { lang, service } = Astro.props;
const r = routes[lang];
const isEnglish = lang === 'en';

const signature = {
  en: {
    metaTitle: 'Signature Treatment Development | 2Hands',
    metaDescription: 'Signature spa treatment concept, protocol and therapist training for hospitality properties with Brooke Wescott.',
    heroEyebrow: 'Hospitality services · Differentiate', heroTitle: 'Create a signature treatment guests remember and teams can deliver.',
    heroLead: "2Hands translates a property's identity into a coherent treatment concept, protocol and training experience, without losing sight of technique or operational reality.",
    heroPrimary: 'Discuss your property', heroSecondary: 'View all services', heroAlt: '2Hands professional massage and spa work',
    imageNote: 'A distinctive experience should be meaningful to the guest and repeatable across the treatment team.',
    proof: [['Technique meets hospitality', '2Hands approach'], ['25+ years', 'International practice'], ['Hands-on', 'Practical development'], ['Two perspectives', 'Guest and practitioner']],
    needEyebrow: 'The need', needTitle: 'A signature treatment needs more than an attractive story.',
    needCopy: 'The strongest concepts connect the brand, local context, therapeutic intention and guest journey. They also work within real treatment times, therapist capabilities, room setup and product availability. 2Hands develops both the experience and the system required to deliver it consistently.',
    audienceEyebrow: 'Who it is for', audienceTitle: 'A focused fit for real hospitality needs.',
    audience: ['New properties building an opening menu', 'Spas refreshing an established treatment offer', 'Hotels seeking a locally relevant hero treatment', 'Teams that need a clearer, more teachable protocol'],
    includesEyebrow: 'What it includes', includesTitle: 'Detailed enough to be useful. Focused enough to act on.',
    includesIntro: 'The final engagement is adapted to the property, the team and the operational question being addressed.',
    includes: ['Concept and treatment story', 'Sequence, rhythm and timing', 'Technique and pressure direction', 'Product and equipment recommendations', 'Written therapist protocol', 'Guest consultation and post-care notes', 'On-site therapist training', 'Pilot, refinement and quality checklist'],
    processEyebrow: 'How it works', processTitle: 'A clear path from need to action.',
    process: [['01', 'Discover', 'Understand the property, guest, location, menu and brand intention.'], ['02', 'Create', 'Develop the treatment concept, flow, techniques and supporting details.'], ['03', 'Pilot', 'Test the experience with therapists and refine timing and delivery.'], ['04', 'Transfer', 'Train the team and provide a protocol that supports consistency.']],
    deliverEyebrow: 'Management receives', deliverTitle: 'A practical output, not a generic report.',
    deliverables: ['A defined treatment concept', 'A detailed written protocol', 'Recommended products and setup', 'Hands-on team training', 'A practical quality-control checklist'],
    scopeEyebrow: 'Scope and timing', scopeTitle: 'Built around the brief.',
    scopeCopy: 'Scope depends on concept depth, protocol complexity, product involvement, team size and whether more than one treatment is being developed.', scopeButton: 'Discuss the scope',
    founderEyebrow: 'Led by Brooke Wescott', founderTitle: 'Experienced hands. Operational perspective.',
    founderCopy: 'Brooke brings more than 25 years of international massage and bodywork experience, combining treatment expertise with a practical understanding of guest expectations and therapist longevity.', founderLink: 'Meet Brooke',
    questionsEyebrow: 'Questions', questionsTitle: 'Before we begin.',
    questions: [['Can 2Hands work with our existing products?', 'Yes. Development can begin with an established product partner or include recommendations that fit the concept and operations.'], ['Can an existing treatment be refined?', 'Yes. The engagement can improve an existing protocol rather than create a completely new one.'], ['Is therapist training included?', 'Training can be included so the final protocol is understood in practice, not simply delivered as a document.']],
    ctaEyebrow: 'Start a conversation', ctaTitle: 'Turn your property story into a treatment experience.',
    ctaCopy: 'Tell Brooke about the property, concept and current menu to begin shaping the right brief.', ctaButton: 'Discuss your property',
  },
  fr: {
    metaTitle: 'Création de soins signature | 2Hands',
    metaDescription: 'Concept, protocole et formation pour créer un soin signature hôtelier distinctif avec Brooke Wescott.',
    heroEyebrow: 'Services hôteliers · Différencier', heroTitle: 'Créer un soin signature mémorable et maîtrisé par l’équipe.',
    heroLead: '2Hands traduit l’identité d’un établissement en concept, protocole et expérience de formation cohérents, sans perdre de vue la technique ni la réalité opérationnelle.',
    heroPrimary: 'Parler de votre établissement', heroSecondary: 'Voir tous les services', heroAlt: 'Travail professionnel 2Hands en massage et spa',
    imageNote: 'Une expérience distinctive doit avoir du sens pour le client et rester reproductible par toute l’équipe.',
    proof: [['Technique et hospitalité', 'L’approche 2Hands'], ['25+ ans', 'Pratique internationale'], ['Pratique', 'Développement concret'], ['Deux regards', 'Client et praticien']],
    needEyebrow: 'Le besoin', needTitle: 'Un soin signature exige plus qu’une belle histoire.',
    needCopy: 'Les meilleurs concepts relient la marque, le lieu, l’intention thérapeutique et le parcours client. Ils doivent également fonctionner avec les temps de soin, les compétences de l’équipe, la cabine et les produits disponibles.',
    audienceEyebrow: 'Pour qui', audienceTitle: 'Une réponse ciblée aux besoins réels de l’hospitalité.',
    audience: ['Un nouvel établissement qui construit sa carte', 'Un spa qui renouvelle son offre', 'Un hôtel qui recherche un soin phare ancré dans son identité', 'Une équipe qui a besoin d’un protocole plus clair et transmissible'],
    includesEyebrow: 'Ce qui est inclus', includesTitle: 'Assez détaillé pour être utile. Assez ciblé pour agir.',
    includesIntro: 'L’intervention finale est adaptée à l’établissement, à l’équipe et à la question opérationnelle.',
    includes: ['Concept et histoire du soin', 'Séquence, rythme et timing', 'Direction technique et pression', 'Recommandations produits et matériel', 'Protocole praticien écrit', 'Accueil client et conseils après soin', 'Formation pratique de l’équipe', 'Test, ajustement et grille qualité'],
    processEyebrow: 'Le déroulement', processTitle: 'Un chemin clair du besoin à l’action.',
    process: [['01', 'Découvrir', 'Comprendre l’établissement, le client, le lieu, la carte et l’intention.'], ['02', 'Créer', 'Développer le concept, la fluidité, les techniques et les détails.'], ['03', 'Tester', 'Expérimenter avec les praticiens et ajuster le rythme et le timing.'], ['04', 'Transmettre', 'Former l’équipe et fournir un protocole qui soutient la régularité.']],
    deliverEyebrow: 'Pour la direction', deliverTitle: 'Un résultat pratique, pas un rapport générique.',
    deliverables: ['Un concept de soin défini', 'Un protocole écrit détaillé', 'Des recommandations de produits et de mise en place', 'La formation pratique de l’équipe', 'Une grille de contrôle qualité'],
    scopeEyebrow: 'Périmètre et calendrier', scopeTitle: 'Construit autour du brief.',
    scopeCopy: 'Le périmètre dépend de la profondeur du concept, de la complexité du protocole, des produits, de la taille de l’équipe et du nombre de soins développés.', scopeButton: 'Discuter du périmètre',
    founderEyebrow: 'Avec Brooke Wescott', founderTitle: 'Une expertise pratique et un regard opérationnel.',
    founderCopy: 'Brooke apporte plus de 25 ans d’expérience internationale en massage et bodywork, avec une compréhension concrète des attentes du client et de la longévité du praticien.', founderLink: 'Découvrir Brooke',
    questionsEyebrow: 'Questions', questionsTitle: 'Avant de commencer.',
    questions: [['Peut-on utiliser nos produits actuels ?', 'Oui. Le développement peut partir d’un partenaire produit existant ou inclure des recommandations adaptées.'], ['Peut-on améliorer un soin existant ?', 'Oui. L’intervention peut affiner un protocole actuel plutôt que repartir de zéro.'], ['La formation des praticiens est-elle incluse ?', 'Elle peut être intégrée afin que le protocole soit compris dans la pratique et pas seulement livré comme document.']],
    ctaEyebrow: 'Commencer l’échange', ctaTitle: 'Transformez l’histoire de votre établissement en expérience de soin.',
    ctaCopy: 'Présentez à Brooke l’établissement, le concept et la carte actuelle pour commencer à définir le bon brief.', ctaButton: 'Parler de votre établissement',
  },
