---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, type Language } from '../data/site';
import '../styles/privacy.css';

interface Props { lang: Language }
const { lang } = Astro.props;
const isEnglish = lang === 'en';
const r = routes[lang];

const copy = isEnglish ? {
  metaTitle: 'Privacy Policy | 2Hands Massage Academy',
  metaDescription: 'Learn how 2Hands Massage Academy collects, uses and protects personal information submitted through its website.',
  eyebrow: 'Privacy & personal information',
  title: 'Privacy Policy',
  intro: 'This policy explains how personal information submitted through the 2Hands website is used, protected and retained.',
  updated: 'Last updated: 2 October 2026',
  sections: [
    ['1. Who is responsible for your information', `The data controller for this website is 2 HANDS MASSAGE ACADEMY, 49 Rue Jean Jaurès, 6th floor, Apartment 12, Quartier Gauthier, Casablanca, Morocco. You can contact 2Hands by telephone at +212 (0) 6 28 10 52 36 or by email at Brookes2hands@gmail.com.`],
    ['2. Information we collect', 'When you send an enquiry, we collect the information you choose to provide. Depending on the form, this may include your name, email address, role, property or organisation, city, team size, service interest, preferred timing, professional experience and message. Required fields are marked in the form.'],
    ['3. Why we use it', 'Your information is used to receive and answer your enquiry, understand the service or training you are interested in, prepare relevant follow-up and protect the website from misuse. It is not added to a marketing mailing list through these forms.'],
    ['4. Legal basis and consent', 'The forms ask for your explicit consent before submission. Processing is also limited to responding to a request you have initiated and, where relevant, taking steps before a possible service agreement. You may withdraw your consent or object to further use by contacting 2Hands.'],
    ['5. Who receives the information', 'Enquiries are received by Brooke Wescott and may be accessed only by people authorised to support 2Hands. Cloudflare provides website hosting, delivery and security; Resend transmits the enquiry email; and Google Gmail receives it in the business inbox. These providers may process technical or message data using infrastructure outside Morocco, subject to their applicable safeguards and terms.'],
    ['6. How long we keep it', 'An enquiry that does not become a client relationship is retained for no more than 12 months after the last meaningful exchange, unless an earlier deletion is requested or a legal reason requires otherwise. If a service relationship begins, relevant records may be retained for the duration of that relationship and for any additional period required by accounting, contractual or legal obligations.'],
    ['7. Your rights', 'In accordance with applicable data-protection rules, you may request access to or correction of your personal information, and you may object to its processing on legitimate grounds. Where applicable, you may also request deletion. Send your request to Brookes2hands@gmail.com or to the postal address above. Identity verification may be requested before acting on a request.'],
    ['8. Security', '2Hands uses reasonable technical and organisational measures to restrict access and protect information during transmission and handling. No online service can guarantee absolute security, but access is limited to what is necessary for handling enquiries.'],
    ['9. Cookies and website analytics', 'The website does not currently use advertising cookies. Cloudflare Web Analytics is used to understand aggregate website performance and does not use cookies, local storage or individual visitor fingerprinting. If optional tracking technologies are introduced later, this policy and the consent mechanism will be updated before they are activated.'],
    ['10. Changes to this policy', 'This policy may be updated when the website, service providers or legal requirements change. The latest version and its revision date will remain available on this page.'],
  ],
  contactTitle: 'Questions about your information?',
  contactCopy: 'Contact 2Hands directly for a privacy request or a question about this policy.',
  contactButton: 'Contact 2Hands',
} : {
  metaTitle: 'Politique de confidentialité | 2Hands Massage Academy',
  metaDescription: 'Découvrez comment 2Hands Massage Academy collecte, utilise et protège les données personnelles transmises sur son site.',
  eyebrow: 'Confidentialité & données personnelles',
  title: 'Politique de confidentialité',
  intro: 'Cette politique explique comment les données personnelles transmises sur le site 2Hands sont utilisées, protégées et conservées.',
  updated: 'Dernière mise à jour : 2 octobre 2026',
  sections: [
    ['1. Responsable du traitement', `Le responsable du traitement des données collectées sur ce site est 2 HANDS MASSAGE ACADEMY, 49, Rue Jean Jaurès, 6ème étage, Appt 12, Quartier Gauthier, Casablanca, Maroc. Vous pouvez contacter 2Hands par téléphone au +212 (0) 6 28 10 52 36 ou par email à l’adresse Brookes2hands@gmail.com.`],
    ['2. Données collectées', 'Lorsque vous envoyez une demande, nous collectons les informations que vous choisissez de transmettre. Selon le formulaire, il peut s’agir de votre nom, adresse email, fonction, établissement ou organisation, ville, taille d’équipe, service recherché, période souhaitée, expérience professionnelle et message. Les champs obligatoires sont signalés dans le formulaire.'],
    ['3. Finalités du traitement', 'Vos données sont utilisées pour recevoir et traiter votre demande, comprendre le service ou la formation qui vous intéresse, préparer un suivi pertinent et protéger le site contre les usages abusifs. L’envoi d’un formulaire ne vous inscrit pas à une liste de prospection commerciale.'],
    ['4. Base du traitement et consentement', 'Les formulaires demandent votre consentement explicite avant l’envoi. Le traitement est également limité à la réponse à une demande que vous avez initiée et, le cas échéant, aux démarches préalables à une éventuelle prestation. Vous pouvez retirer votre consentement ou vous opposer à une utilisation ultérieure en contactant 2Hands.'],
    ['5. Destinataires et prestataires', 'Les demandes sont reçues par Brooke Wescott et peuvent uniquement être consultées par les personnes autorisées à accompagner 2Hands. Cloudflare assure l’hébergement, la diffusion et la sécurité du site ; Resend transmet l’email de demande ; et Google Gmail le reçoit dans la boîte professionnelle. Ces prestataires peuvent traiter des données techniques ou le contenu du message au moyen d’infrastructures situées hors du Maroc, selon leurs garanties et conditions applicables.'],
    ['6. Durée de conservation', 'Une demande qui ne donne pas lieu à une relation client est conservée au maximum 12 mois après le dernier échange significatif, sauf demande de suppression antérieure ou obligation légale contraire. Lorsqu’une prestation débute, les éléments nécessaires peuvent être conservés pendant la relation, puis durant toute période supplémentaire imposée par les obligations comptables, contractuelles ou légales.'],
    ['7. Vos droits', 'Conformément aux règles applicables en matière de protection des données, vous pouvez demander l’accès à vos données personnelles ou leur rectification, et vous opposer à leur traitement pour des motifs légitimes. Lorsque cela s’applique, vous pouvez également demander leur suppression. Adressez votre demande à Brookes2hands@gmail.com ou à l’adresse postale indiquée ci-dessus. Une vérification d’identité pourra être demandée avant le traitement de la demande.'],
    ['8. Sécurité', '2Hands met en œuvre des mesures techniques et organisationnelles raisonnables pour limiter l’accès aux données et les protéger pendant leur transmission et leur traitement. Aucun service en ligne ne peut garantir une sécurité absolue, mais l’accès est limité à ce qui est nécessaire au traitement des demandes.'],
    ['9. Cookies et mesure d’audience', 'Le site n’utilise actuellement aucun cookie publicitaire. Cloudflare Web Analytics permet de mesurer les performances globales du site sans utiliser de cookies, de stockage local ni de technique d’identification individuelle des visiteurs. Si des technologies de suivi optionnelles sont ajoutées ultérieurement, cette politique et le mécanisme de consentement seront mis à jour avant leur activation.'],
    ['10. Évolution de cette politique', 'Cette politique peut évoluer lorsque le site, les prestataires ou les exigences légales changent. La version la plus récente et sa date de mise à jour resteront disponibles sur cette page.'],
  ],
  contactTitle: 'Une question concernant vos données ?',
  contactCopy: 'Contactez directement 2Hands pour exercer un droit ou poser une question sur cette politique.',
  contactButton: 'Contacter 2Hands',
};
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} {lang} enPath={routes.en.privacy} frPath={routes.fr.privacy}>
  <main id="main-content" class="privacy-page">
    <section class="privacy-hero">
      <div class="container privacy-hero-inner assessment-hero-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p>{copy.intro}</p>
        <small>{copy.updated}</small>
      </div>
    </section>
    <section class="privacy-content">
      <div class="container privacy-layout">
        <aside aria-label={isEnglish ? 'Business contact details' : 'Coordonnées de l’entreprise'}>
          <strong>2 HANDS MASSAGE ACADEMY</strong>
          <address>
            49, Rue Jean Jaurès<br />
            6ème étage, Appt 12<br />
            Quartier Gauthier, Casablanca<br />
            Maroc
          </address>
          <a href="tel:+212628105236">+212 (0) 6 28 10 52 36</a>
          <a href="mailto:Brookes2hands@gmail.com">Brookes2hands@gmail.com</a>
        </aside>
        <div class="privacy-sections">
          {copy.sections.map(([title, text]) => <section><h2>{title}</h2><p>{text}</p></section>)}
        </div>
      </div>
    </section>
    <section class="privacy-contact">
      <div class="container privacy-contact-inner">
        <div><h2>{copy.contactTitle}</h2><p>{copy.contactCopy}</p></div>
        <a class="button button-primary" href={r.contact}>{copy.contactButton}</a>
      </div>
    </section>
  </main>
</BaseLayout>
