  whyIndex: '05 · Why 2Hands',
  whyEyebrow: 'Beyond a general spa audit',
  whyTitle: 'The treatment itself becomes measurable and improvable.',
  whyAlt: 'Hands preparing for a professional massage treatment',
  reasons: [['Technical massage expertise', 'The ability to assess touch, pace, pressure, transitions and posture, not only the environment surrounding the treatment.'], ['A human and operational perspective', 'The guest’s experience, the practitioner’s reality and management’s needs are considered together.'], ['Action directly connected to the findings', 'Training recommendations follow from observed gaps, with a development-led rather than punitive approach.']],
  proofIndex: '06 · The proof',
