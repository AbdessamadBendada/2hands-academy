---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, type Language } from '../data/site';
import { selectTestimonials } from '../data/testimonials';
import '../styles/homepage.css';
import brookeTeaching from '../assets/images/brooke-teaching-landscape.webp';
import brookePortrait from '../assets/images/brooke-portrait.jpeg';
import treatmentPhoto from '../assets/images/current-site-photo-4.jpg';
