  authority: [['25+ ans', 'de pratique internationale, en cabinet privé, hôtellerie de luxe et auprès d’une clientèle internationale'], ['Expertise technique', 'évaluation des thérapeutes, transmission pratique et développement axé sur la performance'], ['Double perspective', 'expérience client, performance, biomécanique et longévité professionnelle du thérapeute']],
