---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} {lang} enPath={routes.en.home} frPath={routes.fr.home}>
  <main id="main-content" class="homepage">
    <section class="home-hero-shell" id={isEnglish ? 'home' : 'accueil'}>
      <div class="container home-hero-grid">
        <div class="home-hero-copy">
          <span class="eyebrow">{copy.heroEyebrow}</span>
          <h1><span class="home-title-desktop">{copy.heroTitle}</span><span class="home-title-mobile">{copy.mobileHeroTitle}</span></h1>
          <p class="home-hero-lead">{copy.heroLead}</p>
          <div class="home-hero-actions"><a class="button button-primary" href={r.services}>{copy.heroPrimary}</a><a class="button button-outline" href={r.contact}>{copy.heroSecondary}</a></div>
          <div class="home-hero-meta home-hero-meta-desktop">{copy.heroMeta.map(([one, two]) => <span>{one}<br />{two}</span>)}</div>
        </div>
        <figure class="home-hero-visual"><Image src={brookeTeaching} alt={copy.heroAlt} widths={[640, 900, 1200]} sizes="(min-width: 900px) 43vw, 100vw" loading="eager" fetchpriority="high" /><figcaption>{copy.heroCaption}</figcaption></figure>
        <div class="home-hero-meta home-hero-meta-mobile">{copy.heroMeta.map(([one, two]) => <span>{one}<br />{two}</span>)}</div>
      </div>
    </section>

    <section class="home-proof-strip" aria-label={copy.proofLabel}>
      <div class="container home-proof-inner">
        <p class="home-proof-label">{copy.proofLabel}</p>
        <div class="home-logo-row" aria-label={copy.proofAria}>
          <div class="home-client-logo home-four-seasons"><Image src={fourSeasonsLogo} alt="Four Seasons Hotels and Resorts" loading="lazy" /></div>
          <div class="home-client-logo"><div class="home-client-wordmark">Anfa Cliff<small>Wellness Center</small></div></div>
          <div class="home-client-logo"><Image src={nisaeLogo} alt="Nisaē" loading="lazy" /></div>
          <div class="home-client-logo"><Image src={endorfineLogo} alt="Endorfine" loading="lazy" /></div>
          <div class="home-client-logo"><Image src={myShalaLogo} alt="My Shala" loading="lazy" /></div>
          <div class="home-client-logo"><div class="home-client-wordmark">Matrescence<small>By Meryem</small></div></div>
        </div>
      </div>
    </section>

    <section class="home-section" id={isEnglish ? 'hospitality' : 'hospitalite'}>
      <div class="container">
        <div class="home-intro-row"><div><span class="home-section-index">{copy.challengeIndex}</span><span class="eyebrow">{copy.challengeEyebrow}</span><h2>{copy.challengeTitle}</h2></div><div class="home-intro-copy"><p>{copy.challengeIntro}</p><p>{copy.challengeCopy}</p></div></div>
        <div class="home-challenge-detail"><figure class="home-challenge-image"><Image src={treatmentPhoto} alt={copy.challengeAlt} widths={[800, 1200, 1600]} sizes="(min-width: 900px) 65vw, 100vw" loading="lazy" /></figure><div class="home-challenge-note"><span class="eyebrow eyebrow-light">{copy.standardEyebrow}</span><strong>{copy.standardTitle}</strong><p>{copy.standardDetails}</p></div></div>
      </div>
    </section>

    <section class="home-founder-section" id="brooke">
      <div class="home-founder-grid"><figure class="home-founder-photo"><Image src={brookePortrait} alt={copy.founderAlt} widths={[640, 900]} sizes="(min-width: 900px) 39vw, 100vw" loading="lazy" /></figure><div class="home-founder-content"><span class="home-section-index">{copy.founderIndex}</span><span class="eyebrow">{copy.founderEyebrow}</span><h2>{copy.founderTitle}</h2><p class="home-founder-lead">{copy.founderLead}</p><div class="home-authority-list">{copy.authority.map(([title, detail]) => <div class="home-authority-item"><strong>{title}</strong><span>{detail}</span></div>)}</div><div><a class="text-link" href={r.about}>{copy.founderLink}</a></div></div></div>
    </section>

    <section class="home-membership-section" aria-labelledby="credentials-title">
      <div class="container">
        <div class="home-credentials-heading"><div><span class="eyebrow">{copy.credentialsEyebrow}</span><h2 id="credentials-title">{copy.credentialsTitle}</h2></div><p>{copy.credentialsIntro}</p></div>
        <div class="home-membership-card"><Image class="home-membership-seal" src={wmfSeal} alt={copy.membershipAlt} width={128} loading="lazy" /><div class="home-membership-copy"><span class="eyebrow">{copy.membershipEyebrow}</span><h2>{copy.membershipTitle}</h2><p>{copy.membershipCopy}</p></div><div class="home-membership-action"><a class="button button-outline" href="https://worldmassagefederation.com/project/members/" target="_blank" rel="noopener">{copy.membershipButton}</a><small>{copy.membershipNote}</small></div></div>
        <div class="home-recognition-grid" aria-label={copy.recognitionAria}>{copy.recognition.map(([title, detail]) => <article><h3>{title}</h3><p>{detail}</p></article>)}</div>
      </div>
    </section>

    <section class="home-section home-services-section" id="services"><div class="container"><div class="home-services-heading"><div><span class="home-section-index">{copy.servicesIndex}</span><span class="eyebrow">{copy.servicesEyebrow}</span><h2>{copy.servicesTitle}</h2></div><p>{copy.servicesIntro}</p></div><div class="home-services-grid">{copy.services.map(([label, title, detail, linkLabel, href], index) => <article class="home-service-card"><div class="home-service-topline"><span>{label}</span>{index === 0 && <mark>{copy.recommended}</mark>}</div><h3>{title}</h3><p>{detail}</p><a class="text-link" href={href}>{linkLabel}</a></article>)}</div></div></section>

    <section class="home-process-section" aria-labelledby="process-title"><div class="container"><div class="home-process-heading"><div><span class="home-section-index">{copy.processIndex}</span><span class="eyebrow eyebrow-light">{copy.processEyebrow}</span><h2 id="process-title">{copy.processTitle}</h2></div><p>{copy.processIntro}</p></div><div class="home-process">{copy.process.map(([number, title, detail]) => <article><span>{number}</span><h3>{title}</h3><p>{detail}</p></article>)}</div></div></section>

    <section class="home-why-section"><div class="home-why-grid"><figure class="home-why-image"><Image src={handsPhoto} alt={copy.whyAlt} widths={[700, 1000]} sizes="(min-width: 900px) 43vw, 100vw" loading="lazy" /></figure><div class="home-why-content"><span class="home-section-index">{copy.whyIndex}</span><span class="eyebrow">{copy.whyEyebrow}</span><h2>{copy.whyTitle}</h2><div class="home-reasons">{copy.reasons.map(([title, detail], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{detail}</p></div></article>)}</div></div></div></section>

    <section class="home-section home-testimonials-section" id="references"><div class="container"><div class="home-testimonial-heading"><div><span class="home-section-index">{copy.proofIndex}</span><span class="eyebrow">{copy.testimonialEyebrow}</span><h2>{copy.testimonialTitle}</h2></div><a class="text-link" href={r.references}>{copy.referencesLink}</a></div><div class="home-quote-grid">{homeTestimonials.map((testimonial) => <article><div><div class="home-quote-context">{testimonial.context}</div><div class="home-quote-mark">“</div><blockquote>{testimonial.excerpt}</blockquote></div><div class="home-quote-attribution"><strong>{testimonial.name}</strong><span>{testimonial.role}{testimonial.organisation ? ` · ${testimonial.organisation}` : ''}</span></div></article>)}</div><p class="home-proof-note">{copy.proofNote}</p></div></section>

    <section class="home-final-cta" id="contact"><div class="container"><span class="eyebrow eyebrow-light">{copy.ctaEyebrow}</span><h2>{copy.ctaTitle}</h2><p>{copy.ctaCopy}</p><div class="home-final-actions"><a class="button button-cream" href={r.contact}>{copy.heroSecondary}</a><a class="button button-outline-light" href={r.services}>{copy.ctaSecondary}</a></div></div></section>

    <section class="home-academy-doorway" id={isEnglish ? 'training' : 'formations'}><div class="container home-academy-inner"><div class="home-academy-label">{copy.academyLabel}</div><div class="home-academy-copy"><h2>{copy.academyTitle}</h2><p>{copy.academyCopy}</p></div><a class="button button-primary" href={r.academy}>{copy.academyButton}</a></div></section>
  </main>

  <script is:inline>
    (() => {
      const page = document.querySelector('.homepage');
      if (!page || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const revealSelectors = [
        '.home-proof-inner',
        '.home-intro-row',
        '.home-challenge-detail',
        '.home-founder-grid',
        '.home-credentials-heading',
        '.home-membership-card',
        '.home-recognition-grid > article',
        '.home-services-heading',
        '.home-services-grid > article',
        '.home-process-heading',
        '.home-process > article',
        '.home-why-grid',
        '.home-testimonial-heading',
        '.home-quote-grid > article',
        '.home-final-cta > .container',
        '.home-academy-inner',
      ];

      const elements = [...page.querySelectorAll(revealSelectors.join(','))];
      const staggerGroups = [
        '.home-recognition-grid',
        '.home-services-grid',
        '.home-process',
        '.home-quote-grid',
      ];

      elements.forEach((element) => element.setAttribute('data-home-reveal', ''));
      staggerGroups.forEach((selector) => {
        page.querySelectorAll(`${selector} > *`).forEach((element, index) => {
          element.style.setProperty('--home-reveal-delay', `${Math.min(index * 70, 210)}ms`);
        });
      });

      page.classList.add('motion-ready');

      if (!('IntersectionObserver' in window)) {
        elements.forEach((element) => element.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

      requestAnimationFrame(() => elements.forEach((element) => observer.observe(element)));
    })();
  </script>
</BaseLayout>
