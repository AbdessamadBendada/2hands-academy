  founderAlt: 'Professional portrait of Brooke Wescott',
  authority: [['25+ years', 'international practice across private practice, luxury hospitality and international clientele'], ['Technique-focused', 'therapist assessment, practical knowledge transfer and performance-focused development'], ['Two perspectives', 'guest experience, therapist performance, body mechanics and career longevity']],
  founderLink: 'Discover Brooke’s background',
  credentialsEyebrow: 'Professional standing',
  credentialsTitle: 'Certifications, affiliations & recognition.',
  credentialsIntro: 'Brooke’s professional standing brings together international affiliation, continued professional development and recognition across massage, wellness and hospitality.',
