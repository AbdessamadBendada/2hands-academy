  membershipEyebrow: 'Affiliation internationale',
  membershipTitle: 'Membre officiel de la World Massage Federation.',
  membershipCopy: '2Hands fait partie d’une communauté internationale dédiée au développement de la pratique, de la formation et de l’excellence professionnelle dans le massage.',
  membershipButton: 'Vérifier l’adhésion',
  membershipNote: 'Adhésion confirmée · vérification sur le site officiel',
