interface Props { lang: Language }
const { lang } = Astro.props;
const r = routes[lang];
const isEnglish = lang === 'en';
const homeTestimonials = selectTestimonials(lang, ['nisae', 'my-shala', 'meryeme-belmrhar']);

const copy = isEnglish ? {
