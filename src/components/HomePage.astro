} : {
  metaTitle: 'Conseil, diagnostic et formation spa au Maroc | 2Hands',
  metaDescription: '2Hands accompagne les hôtels, resorts, riads et spas dans l’évaluation des équipes, la formation et la création d’expériences de soin distinctives.',
